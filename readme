curl -X POST http://localhost:8080/api/users \
-H "Content-Type: application/json" \
-d '{
  "firstName":"John",
  "lastName":"Doe",
  "email":"john@example.com",
  "password":"password123"
}'


curl -i http://localhost:8080/api/users

curl -i http://localhost:8080/api/users \
-H "Authorization: Bearer YOUR_TOKEN"